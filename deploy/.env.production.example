# Copy this file to the repository root as .env.production and fill each required value.
# Runtime mode marker; production-like aliases also enable production security behavior.
VAULTR_ENV=production
# Release tag, for example a reviewed immutable application release name.
RELEASE_TAG=
# Git commit SHA included in application diagnostics and build metadata.
RELEASE_SHA=
# Public web-app hostname without a scheme, for example app.example.org.
APP_HOST=
# Public Word add-in hostname without a scheme, for example word.example.org.
WORD_HOST=
# Email address used by Caddy for certificate expiry notices.
TLS_EMAIL=
# Optional exact HTTPS origins allowed by the Word add-in CSP for telemetry.
WORD_ADDIN_CSP_CONNECT_ORIGINS=

# Public web-app origin, for example https://app.example.org.
FRONTEND_URL=
# Public Word add-in origin, for example https://word.example.org.
WORD_ADDIN_URL=
# Public API proxy URL including the /api prefix, for example https://app.example.org/api.
API_PUBLIC_URL=
# Comma-separated exact browser origins, for example https://app.example.org,https://word.example.org.
ALLOWED_ORIGINS=

# Hosted Supabase project URL copied from its dashboard, for example https://project-ref.supabase.co.
SUPABASE_URL=
# Supabase publishable key copied from the project API settings.
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret service-role key copied from the project API settings.
SUPABASE_SECRET_KEY=
# Supabase JWT signing secret used to validate issued tokens.
JWT_SECRET=

# Generate an independent persistent download-signing key with openssl rand -hex 32.
DOWNLOAD_SIGNING_SECRET=
# Generate an independent provider-key encryption key with openssl rand -hex 32.
USER_API_KEYS_ENCRYPTION_SECRET=
# Generate a separate OAuth/MCP credential encryption key with openssl rand -hex 32.
MCP_CONNECTORS_ENCRYPTION_SECRET=
# Generate an independent Word add-in handoff encryption key with openssl rand -hex 32.
AUTH_HANDOFF_ENCRYPTION_SECRET=

# Private HTTPS S3-compatible API endpoint copied from the storage provider.
R2_ENDPOINT_URL=
# Private bucket name with anonymous access disabled.
R2_BUCKET_NAME=
# Restricted storage access-key identifier for the application.
R2_ACCESS_KEY_ID=
# Restricted storage secret access key for the application.
R2_SECRET_ACCESS_KEY=
# Optional HTTPS browser-facing object endpoint; leave blank when unused.
R2_PUBLIC_ENDPOINT_URL=

# Optional Supabase Google OAuth client ID when Google login is enabled.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# Optional Supabase Google OAuth client secret when Google login is enabled.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Optional Google Drive OAuth client ID for the Drive connector.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# Optional Google Drive OAuth client secret for the Drive connector.
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# Optional Google Workspace OAuth client ID for Gmail and Calendar connectors.
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# Optional Google Workspace OAuth client secret for Gmail and Calendar connectors.
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
# Optional Google MCP OAuth client ID for MCP-based Google authorization.
GOOGLE_MCP_OAUTH_CLIENT_ID=
# Optional Google MCP OAuth client secret for MCP-based Google authorization.
GOOGLE_MCP_OAUTH_CLIENT_SECRET=
# Optional Slack MCP OAuth client ID when that connector is enabled.
SLACK_MCP_OAUTH_CLIENT_ID=
# Optional Slack MCP OAuth client secret when that connector is enabled.
SLACK_MCP_OAUTH_CLIENT_SECRET=
# Optional OpenAI-compatible model provider key for administrators.
OPENAI_API_KEY=
# Optional Anthropic model provider key for administrators.
ANTHROPIC_API_KEY=
# Optional Google Gemini model provider key for administrators.
GEMINI_API_KEY=
# Optional OpenRouter model provider key for administrators.
OPENROUTER_API_KEY=
# Optional Vercel AI Gateway model provider key for administrators.
AI_GATEWAY_API_KEY=
# Optional OpenCode model provider key for administrators.
OPENCODE_API_KEY=
# Optional Claude model provider key for administrators.
CLAUDE_API_KEY=
# Optional local Ollama authorization key when the selected endpoint requires one.
OLLAMA_API_KEY=
# Optional CourtListener API token for legal search features.
COURTLISTENER_API_TOKEN=
# Optional private workflow catalog GitHub token; leave blank for public sources.
MIKE_WORKFLOWS_GITHUB_TOKEN=
# Optional S3-compatible workflow repository owner and name.
MIKE_WORKFLOWS_REPOSITORY=
# Optional immutable workflow catalog commit or reviewed branch name.
MIKE_WORKFLOWS_REF=
# Optional Ed25519 private seed as 64 hex characters; blank leaves export manifests unsigned.
MANIFEST_SIGNING_KEY=
# Optional dedicated Spotlight nonce key; blank uses the configured download-signing key.
SPOTLIGHT_NONCE_SECRET=
# Optional auth handoff lifetime in seconds; leave blank to use the bounded application default.
AUTH_HANDOFF_TTL_SECONDS=
# Keep background OAuth refresh disabled unless the provider and job behavior are reviewed.
MCP_OAUTH_BACKGROUND_REFRESH_ENABLED=false
# Keep enterprise single sign-on disabled until identity-domain ownership is verified.
SSO_ENABLED=false
# Optional comma-separated exact email domains allowed by enterprise single sign-on.
SSO_ALLOWED_DOMAINS=
# Keep legal bulk-data downloads disabled unless a managed import plan exists.
COURTLISTENER_BULK_DATA_ENABLED=false
# Keep workflow contribution routes disabled unless their review process is enabled.
WORKFLOW_CONTRIBUTIONS_ENABLED=false

# Generate a URL-safe Redis password with openssl rand -hex 32.
REDIS_PASSWORD=
# Number of trusted proxy addresses; use 1 for the bundled Caddy to app path.
TRUST_PROXY_HOPS=1
# Number of API replicas; keep at 1 unless every replica uses this shared Redis.
API_REPLICAS=1

# Optional backend Sentry DSN for error reporting.
SENTRY_DSN=
# Optional frontend Sentry DSN compiled into the web app.
FRONTEND_SENTRY_DSN=
# Optional browser-visible Sentry DSN compiled into the web app bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Optional browser Sentry environment name, normally production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional browser Sentry release label, normally the release tag.
NEXT_PUBLIC_SENTRY_RELEASE=
# Optional browser Sentry install label used for event grouping.
NEXT_PUBLIC_SENTRY_INSTALL=
# Optional Word add-in Sentry environment name, normally production.
REACT_APP_SENTRY_ENVIRONMENT=production
# Optional Word add-in Sentry release label, normally the release tag.
REACT_APP_SENTRY_RELEASE=
# Optional Word add-in Sentry install label used for event grouping.
REACT_APP_SENTRY_INSTALL=
# Optional Word add-in Sentry DSN compiled into the add-in.
WORD_ADDIN_SENTRY_DSN=
# Disable backend Sentry only after reviewing the monitoring plan.
SENTRY_DISABLED=false
# Disable browser Sentry only after reviewing the monitoring plan.
NEXT_PUBLIC_SENTRY_DISABLED=false
# Disable Word add-in Sentry only after reviewing the monitoring plan.
REACT_APP_SENTRY_DISABLED=false
# Backend Sentry install label for operational dashboards.
SENTRY_INSTALL=
# Backend Sentry environment name, normally production.
SENTRY_ENVIRONMENT=production
# Backend Sentry release label, normally the release tag.
SENTRY_RELEASE=
# Backend Sentry sample rate between 0 and 1 for performance traces.
SENTRY_TRACES_SAMPLE_RATE=0.05
# Browser Sentry sample rate between 0 and 1 for performance traces.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01

# Keep verbose model tool-call diagnostics disabled in production.
DEBUG_LLM_TOOL_CALLS=0
# Keep raw model stream logging disabled to protect prompts and responses.
LOG_RAW_LLM_STREAM=false
# Keep Sentry SDK debug logging disabled in production.
SENTRY_DEBUG=false
# Keep the test-only Sentry route disabled in production.
SENTRY_ENABLE_TEST_ROUTE=false

# Optional comma-separated exact private model endpoint origins; never add broad ranges.
MODEL_PRIVATE_ENDPOINT_ALLOWLIST=
# Optional private Ollama endpoint; use only a specifically reviewed private host.
OLLAMA_BASE_URL=

# General rate-limit window in minutes.
RATE_LIMIT_GENERAL_WINDOW_MINUTES=15
# General authenticated request budget per user per window.
RATE_LIMIT_GENERAL_MAX=300
# Coarse general request budget per client IP per window.
RATE_LIMIT_GENERAL_IP_MAX=15000
# Chat request window in minutes.
RATE_LIMIT_CHAT_WINDOW_MINUTES=15
# Chat request budget per user per window.
RATE_LIMIT_CHAT_MAX=30
# Coarse chat request budget per client IP per window.
RATE_LIMIT_CHAT_IP_MAX=1500
# Chat creation window in minutes.
RATE_LIMIT_CHAT_CREATE_WINDOW_MINUTES=15
# Chat creation budget per user per window.
RATE_LIMIT_CHAT_CREATE_MAX=60
# Coarse chat creation budget per client IP per window.
RATE_LIMIT_CHAT_CREATE_IP_MAX=3000
# Tool-result processing window in minutes.
RATE_LIMIT_TOOL_RESULT_WINDOW_MINUTES=15
# Tool-result processing budget per user per window.
RATE_LIMIT_TOOL_RESULT_MAX=2000
# Coarse tool-result processing budget per client IP per window.
RATE_LIMIT_TOOL_RESULT_IP_MAX=100000
# Export creation window in hours.
RATE_LIMIT_EXPORT_WINDOW_HOURS=1
# Export creation budget per user per window.
RATE_LIMIT_EXPORT_MAX=10
# Coarse export creation budget per client IP per window.
RATE_LIMIT_EXPORT_IP_MAX=500
# Workflow-import window in hours.
RATE_LIMIT_UPLOAD_WINDOW_HOURS=1
# Workflow-import budget per user per window.
RATE_LIMIT_UPLOAD_MAX=50
# Coarse workflow-import budget per client IP per window.
RATE_LIMIT_UPLOAD_IP_MAX=2500
# Account data-deletion window in hours.
RATE_LIMIT_DATA_DELETE_WINDOW_HOURS=1
# Account data-deletion budget per user per window.
RATE_LIMIT_DATA_DELETE_MAX=20
# Coarse data-deletion budget per client IP per window.
RATE_LIMIT_DATA_DELETE_IP_MAX=1000
# Login-attempt window in minutes.
RATE_LIMIT_AUTH_LOGIN_WINDOW_MINUTES=15
# Failed login budget per client IP per window.
RATE_LIMIT_AUTH_LOGIN_MAX=100
# Account-action window in minutes for signup and password reset identifiers.
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MINUTES=15
# Signup/password-reset budget per account identifier plus client IP.
RATE_LIMIT_AUTH_ACCOUNT_MAX=10
# Email-action window in hours.
RATE_LIMIT_AUTH_EMAIL_WINDOW_HOURS=1
# Signup/password-reset email budget per account identifier plus client IP.
RATE_LIMIT_AUTH_EMAIL_MAX=10
# Coarse email-action budget per client IP per window.
RATE_LIMIT_AUTH_EMAIL_IP_MAX=100
# Auth-flow window in minutes.
RATE_LIMIT_AUTH_FLOW_WINDOW_MINUTES=15
# Auth-flow budget per user or session per window.
RATE_LIMIT_AUTH_FLOW_MAX=30
# Coarse auth-flow budget per client IP per window.
RATE_LIMIT_AUTH_FLOW_IP_MAX=1500
# MFA action window in minutes.
RATE_LIMIT_AUTH_MFA_WINDOW_MINUTES=15
# MFA action budget per user or session per window.
RATE_LIMIT_AUTH_MFA_MAX=20
# Coarse MFA action budget per client IP per window.
RATE_LIMIT_AUTH_MFA_IP_MAX=1000
# Upload-session mutation window in minutes.
RATE_LIMIT_UPLOAD_SESSION_MUTATION_WINDOW_MINUTES=15
# Upload-session mutation budget per user per window.
RATE_LIMIT_UPLOAD_SESSION_MUTATION_MAX=300
# Coarse upload-session mutation budget per client IP per window.
RATE_LIMIT_UPLOAD_SESSION_MUTATION_IP_MAX=15000
# Upload-session polling window in minutes.
RATE_LIMIT_UPLOAD_SESSION_POLL_WINDOW_MINUTES=15
# Upload-session polling budget per user per window.
RATE_LIMIT_UPLOAD_SESSION_POLL_MAX=3000
# Coarse upload-session polling budget per client IP per window.
RATE_LIMIT_UPLOAD_SESSION_POLL_IP_MAX=150000
# Upload-session creation budget per user per hour.
RATE_LIMIT_UPLOAD_SESSION_CREATE_MAX_PER_HOUR=50
# Coarse upload-session creation budget per client IP per hour.
RATE_LIMIT_UPLOAD_SESSION_CREATE_IP_MAX=2500
# Maximum in-memory rate-limit keys before bounded least-recently-used eviction.
RATE_LIMIT_MEMORY_MAX_KEYS=10000
# Circuit-breaker failures before rate limits use the bounded memory fallback.
RATE_LIMIT_REDIS_FAILURE_THRESHOLD=3
# Circuit-breaker recovery wait in milliseconds before probing Redis again.
RATE_LIMIT_REDIS_COOLDOWN_MS=30000
# Maximum rate-limit Redis command time in milliseconds, capped by the application.
RATE_LIMIT_REDIS_TIMEOUT_MS=250
