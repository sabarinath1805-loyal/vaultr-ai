# Server-only upstream used by the same-origin /api gateway.
API_BASE_URL=http://localhost:3001
# Browser-signed storage URLs must use this same public endpoint origin.
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Sentry error reporting is opt-in. Blank DSNs keep local/unset deployments
# offline. NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time; SENTRY_DSN for the Next server is read at runtime. Configured events
# are privacy-scrubbed before sending.
NEXT_PUBLIC_SENTRY_DISABLED=false
NEXT_PUBLIC_SENTRY_INSTALL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DISABLED=false
SENTRY_INSTALL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source-map upload for readable production stack traces; all three required.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
